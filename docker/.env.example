# compose.yml 可选环境变量配置。复制为 .env 后按需修改。
# 部署说明见 docker/README.md，Binder 配置见 docs/BINDER.md。

# 镜像配置
# PICO_IMAGE=ghcr.io/exmeaning/pico-onebot:latest

# 端口映射
PICO_WEBUI_PORT=6099
PICO_ONEBOT_PORT=3001
# ADB 端口（默认仅绑定至 127.0.0.1）
PICO_ADB_PORT=5555

# 日志转发：将 /dev/kmsg（Android init 与系统日志）转发至容器 stdout
# 1 = 关键系统服务日志（默认），all = 全量日志，0 = 关闭转发
PICO_LOG_KMSG=1

# Binder 校验失败处理：0 = 仅输出告警并继续启动（默认），1 = 直接退出容器
PICO_BINDER_STRICT=0
